# Server deployment: set long random values. Never commit your real .env.
APP_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-another-long-random-secret
# Leave false when accessing via a localhost SSH tunnel. True for public HTTPS.
COOKIE_SECURE=false
NPM_REGISTRY=https://registry.npmjs.org
NODE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm-slim

